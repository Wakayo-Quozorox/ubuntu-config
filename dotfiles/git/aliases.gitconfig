[alias]
	co = checkout
	br = branch
	st = status -sb
	ci = commit
	unstage = reset HEAD --
	last = log -1 HEAD
	amend = commit --amend
	tree = "!f() { \
		cols=$(tput cols 2>/dev/null || echo 120); \
		if [ \"$cols\" -lt 70 ]; then \
			msgw=$((cols - 12)); [ \"$msgw\" -lt 20 ] && msgw=20; \
			fmt=\"%C(bold blue)%h%C(reset)%C(bold yellow)%d%C(reset) %C(white)%<($msgw,trunc)%s%C(reset)\"; \
		elif [ \"$cols\" -lt 100 ]; then \
			fmt='%C(bold blue)%h%C(reset)%C(bold yellow)%d%C(reset) %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset)'; \
		else \
			fmt='%C(bold blue)%h%C(reset)%C(bold yellow)%d%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)'; \
		fi; \
		git log --graph --abbrev-commit --decorate --all --format=format:\"$fmt\"; \
	}; f"
